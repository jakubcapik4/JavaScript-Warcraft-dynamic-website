<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('includes/head', { pageTitle: 'Login' }) %>
    <style>
      html, body {
        height: 100%;
        margin: 0;
      }
      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      main {
        flex: 1 0 auto;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 70vh; /* Rovnaká výška ako v príklade s potvrdením */
      }
      .login-container {
        max-width: 400px; /* Menšia šírka pre kompaktnejší vzhľad */
        width: 100%;
        padding: 1.5rem; /* Menší padding */
        margin: 1rem 0;
        background-color: rgba(108, 117, 125, 0.5); /* Rovnaký štýl ako v tvojom predchádzajúcom kóde */
        border: 5px solid #dee2e6;
        border-radius: 0.5rem;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
      }
      footer {
        flex-shrink: 0;
      }
    </style>
  </head>
  <body class="bg-light">
    <!-- Header -->
    <%- include("includes/header.ejs") %>

    <!-- Main Content -->
    <main>
      <!-- Prihlásenie -->
      <div class="login-container">
        <h2 class="text-center nadpisy mb-3">Login</h2>
        <% if (inputData && inputData.errorMessage) { %>
          <div class="alert alert-danger" role="alert">
            <%= inputData.errorMessage %>
          </div>
        <% } %>
        <form id="loginForm" action="/login" method="POST">
          <div class="mb-3">
            <input type="email" class="form-control" name="email" placeholder="E-mail" value="<%= inputData && inputData.email || '' %>" required/>
          </div>
          <div class="mb-3">
            <input type="password" class="form-control" name="password" placeholder="Password" value="<%= inputData && inputData.password || '' %>" required/>
          </div>
          <div class="d-flex justify-content-center">
            <button type="submit" class="btn btn-warning fw-bold w-50">Submit</button>
          </div>
        </form>
      </div>
    </main>

    <!-- Footer -->
    <%- include("includes/footer.ejs") %>

    <!-- Bootstrap JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <!-- Custom JS -->
    <script src="js/script.js"></script>
  </body>
</html>