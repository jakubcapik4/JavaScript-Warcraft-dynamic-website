<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('includes/head', { pageTitle: 'Expansions' }) %>
  </head>
  <body class="bg-light">
    <!-- Header -->
    <%- include("includes/header.ejs") %>

    <!-- Main Content -->
    <main class="container my-5">
      <div class="row gap-5">
        <!-- Flexbox 1 -->
        <div class="col-md-5 d-flex flex-column justify-content-between align-items-center flexbox bg-secondary bg-opacity-50 text-light p-4 rounded">
          <h3 class="text-dark fw-bold">Expansion List</h3>
          <img src="images/WoWExpansions.jpg" alt="Expansion 1" class="img-fluid border border-2 border-dark rounded" style="max-width: 350px" />
        </div>

        <!-- Flexbox 2 -->
        <div class="col-md-5 d-flex flex-column justify-content-between align-items-center flexbox bg-secondary bg-opacity-50 text-dark p-4 rounded">
          <h3 class="text-dark fw-bold">Servers</h3>
          <!-- Server List -->
          <div class="d-flex flex-column w-100 border border-2 border-dark">
            <div class="d-flex justify-content-between border border-2 border-dark p-2">
              <div>Server Name</div>
              <div>Type</div>
              <div>Population</div>
            </div>
            <div class="d-flex justify-content-between border p-2">
              <div>Mal'ganis</div>
              <div>PVE</div>
              <div>mid</div>
            </div>
            <div class="d-flex justify-content-between border p-2">
              <div>Arthas</div>
              <div>PVP</div>
              <div>low</div>
            </div>
            <div class="d-flex justify-content-between border p-2">
              <div>Sylvanas</div>
              <div>TEST</div>
              <div>high</div>
            </div>
            <div class="d-flex justify-content-between border p-2">
              <div>Tyrande</div>
              <div>PVE</div>
              <div>high</div>
            </div>
            <div class="d-flex justify-content-between border p-2">
              <div>Malfurion</div>
              <div>PVP</div>
              <div>low</div>
            </div>
          </div>
          <!-- Buttons -->
          <div class="mt-4 w-50">
            <button class="btn btn-warning w-100 mb-3" style="background-color: blue; color: rgb(218, 218, 33); font-weight: bold; border: none;">Choose World</button>
            <button class="btn btn-primary w-100" style="background-color: red; color: black; font-weight: bold; border: none;">Restart</button>
          </div>
        </div>
      </div>
    </main>

    <!-- Footer -->

    <%- include("includes/footer.ejs") %>

    <!-- Bootstrap JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <!-- Custom JS -->
    <script src="js/script.js"></script>
  </body>
</html>