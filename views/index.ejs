<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('includes/head', { pageTitle: 'World of Warcraft' }) %>
  </head>
  <body class="bg-light">
    <!-- Header -->
    <header class="bg-secondary bg-opacity-50 py-3">
      <nav class="container d-flex justify-content-around align-items-center">
        <a href="/" class="btn btn-warning fw-bold text-primary" id="menuButton"><i class="fas fa-home"></i> Menu</a>
        <% if(locals.isAuth) {%>
        <img src="images/HordeAli.jpg" alt="HordeAli" width="70" height="50" />
        <% } %>
        <a href="/visitUs" class="btn btn-warning fw-bold text-primary" id="contactButton"><i class="fas fa-envelope"></i> Contact</a>
        <% if(locals.isAuth) {%>
        <img src="images/HordeAli.jpg" alt="HordeAli" width="70" height="50" />
        <% } %>
        <a href="https://eu.shop.battle.net/en-gb" class="btn btn-warning fw-bold text-primary" id="shopButton"><i class="fas fa-shopping-cart"></i> Shop</a>
        <p id="message" style="color: red; font-weight: bolder;"><%= error ? error : '' %></p>
      </nav>
    </header>

    <!-- Main Content -->
    <main class="container my-5">
      <div class="row g-4">
        <!-- Flexbox 1 -->
        <div class="col-12 bg-secondary bg-opacity-50 p-4 rounded shadow-sm border border-5">
          <div class="row align-items-center">
            <div class="col-md-8 d-flex flex-column justify-content-between align-items-center">
              <h1>World of Warcraft</h1>
              <p>Welcome to Azeroth, a world of magic and limitless adventure. Experience the ever-expanding fantasy of World of Warcraft for FREE today.</p>
            </div>
            <div class="col-md-4 text-center">
              <img src="images/WoW.jpg" alt="WoW" class="img-fluid rounded" style="max-width: 200px" />
            </div>
          </div>
        </div>

        <!-- Flexbox 2 -->
        <div class="col-12 col-md-6 bg-secondary bg-opacity-50 p-4 rounded shadow-sm border border-5">
          <div class="row align-items-center">
            <div class="col-md-6 text-center">
              <img src="images/WoW.jpg" alt="WoW" class="img-fluid rounded" style="max-width: 200px" />
            </div>
            <div class="col-md-6">
              <p style="font-weight: bold">Your journey begins here! Be the hero you want to be. The choice is yours—but first, you must pick a side. The choice has been made by <%= numberOfSubscriptions %> heroes </p>
            </div>
          </div>
        </div>

        <!-- Subscription -->
        <div class="col-12 col-md-6 bg-secondary bg-opacity-50 p-4 rounded shadow-sm align-items-center border border-5">
          <h2 class="text-center" style="color: blue;">Insert for Subscription</h2>
          <form id="registrationForm" action="/" method="post">
            <div class="mb-3">
              <input type="text" class="form-control" name="name" placeholder="Name" required />
            </div>
            <div class="mb-3">
              <input type="email" class="form-control" name="email" placeholder="E-mail" required />
            </div>
            <div class="mb-3">
              <input type="tel" class="form-control" name="phone" placeholder="Phone Number" required />
            </div>
            <div class="d-flex justify-content-center">
              <button type="submit" class="btn btn-warning fw-bold w-50">Submit</button>
            </div>
          </form>
        </div>

        <!-- Submitted Data -->
        <div id="submittedData" class="col-12 bg-secondary bg-opacity-50 p-4 rounded shadow-sm mt-4 border border-5 d-none">
          <h2 class="text-center" style="color: green;">Submitted Data</h2>
          <p><strong>Name:</strong> <span id="nameDisplay"></span></p>
          <p><strong>E-mail:</strong> <span id="emailDisplay"></span></p>
          <p><strong>Phone Number:</strong> <span id="phoneDisplay"></span></p>
        </div>
      </div>
    </main>

    <!-- Footer -->
<footer class="bg-secondary bg-opacity-50 py-3">
  <nav class="container d-flex justify-content-around align-items-center">
    <form action="/logout" method="POST" class="d-inline me-2 p-0 m-0">
      <button type="submit" class="btn btn-primary text-warning fw-bold" id="expansionButton">Logout</button>
    </form>
    <% if(locals.isAuth) {%>
    <a href="/expansions" class="btn btn-primary text-warning fw-bold" id="expansionButton">Expansions</a>
    <a href="/lore" class="btn btn-primary text-warning fw-bold" id="loreButton">Lore</a>
    <% } %>
    <a href="/visitUs" class="btn btn-primary text-warning fw-bold" id="visitUsButton">Visit Us!</a>
    <a href="http://google.com" class="btn btn-warning fw-bold text-primary" id="googleButton"><i class="fab fa-google"></i> Google</a>
    <p style="color: blue; font-size: 24px; font-family: Franklin Gothic Medium;">©Blizzard World</p>
  </nav>
</footer>

    <!-- Bootstrap JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <!-- Custom JS -->
    <script src="js/script.js"></script>
  </body>
</html>